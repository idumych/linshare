# haiku-app.env — what the beos-app-platforms release tools need to know about this app.
# Shell syntax: sourced by packaging/*.sh, the CI workflow and the
# release scripts (check-artifact.sh, release-gate.sh). Keep values quoted; no spaces around '='.

# ── Identity ──
APP_NAME="LinShare"                    # binary name = window/team name
APP_CMD="linshare"                     # package name and command, lowercase
APP_SIG="application/x-vnd.LinShare"   # must equal the .rdef app_signature
RDEF="source/hishare/LinShare.rdef"    # path of the resource definition

PLATFORMS="linux"                      # Linux only: HiShare itself ships the Haiku package

# ── Version (also in the .rdef app_version) ──
# LinShare follows HiShare's version: 1.2.0 is HiShare 1.2 for Linux.
VERSION="1.2.0"
REVISION="1"

# ── Package metadata ──
SUMMARY="File sharing and chat over BeShare servers (HiShare for Linux)"
DESCRIPTION_FILE="packaging/description.txt"   # plain text; blank line = paragraph
HOMEPAGE="https://github.com/idumych/linshare"
GITHUB_REPO="idumych/linshare"
LICENSE_NAME="Public Domain"           # app code; MUSCLE (BSD) and the rest are in LICENSE
COPYRIGHT="1999-2026 Jeremy Friesner, Vitaliy Mikitchenko, atomozero and the LinShare contributors"
PACKAGER="idumych <idumych@gmail.com>"

# Extra runtime dependencies beyond the Haiku API itself
HPKG_REQUIRES_EXTRA=""                 # e.g. "lib:libsqlite3 lib:libcrypto"
DESKTOP_CATEGORIES="Network;FileTransfer;Chat;"   # freedesktop categories for the AppImage
APPIMAGE_MUST_BUNDLE="libbnetapi"      # libs check-artifact.sh must find bundled
APPIMAGE_FONTS_EXTRA=""                # fonts the app selects by family
APPIMAGE_TRANSLATORS="PNG"             # its artwork, and /screenshot writes PNG
COSMOE_REPO=""                         # "" = idumych/hokku
COSMOE_TAG=""                          # its tag or branch ("" = hokku)
SMOKE_ARGS="127.0.0.1"                 # CI starts it against a server address that isn't
                                       # there, not the public BeShare servers
APPIMAGE_APT_EXTRA=""                  # extra Ubuntu 24.04 -dev packages the AppImage CI needs

# ── Build ──
HPKG_BUILD_DEPS=""                     # Haiku -devel packages the build needs
TEST_CMD=""                            # upstream has no host-side tests (md5test needs Haiku)
TYPECHECK_SRCS="source/hishare/ChatWindow.cpp source/hishare/ColorPicker.cpp source/hishare/main.cpp source/hishare/md5.cpp source/hishare/PirateDemo.cpp source/hishare/PortMapper.cpp source/hishare/PrivateChatWindow.cpp source/hishare/ReflowingTextView.cpp source/hishare/RemoteFileItem.cpp source/hishare/RemoteInfo.cpp source/hishare/RemoteUserItem.cpp source/hishare/santa/BetterScrollView/BetterScrollView.cpp source/hishare/santa/ColumnListView/CLVColumn.cpp source/hishare/santa/ColumnListView/CLVColumnLabelView.cpp source/hishare/santa/ColumnListView/CLVEasyItem.cpp source/hishare/santa/ColumnListView/CLVListItem.cpp source/hishare/santa/ColumnListView/ColumnListView.cpp source/hishare/santa/Cursors/Cursors.cpp source/hishare/santa/NewStrings/NewStrings.cpp source/hishare/santa/PrefilledBitmap/PrefilledBitmap.cpp source/hishare/santa/ScrollViewCorner/ScrollViewCorner.cpp source/hishare/ServerConnection.cpp source/hishare/ShareApplication.cpp source/hishare/ShareColumn.cpp source/hishare/ShareFileTransfer.cpp source/hishare/ShareMIMEInfo.cpp source/hishare/ShareNetClient.cpp source/hishare/ShareSettingsWindow.cpp source/hishare/ShareStrings.cpp source/hishare/ShareUtils.cpp source/hishare/ShareWindow.cpp source/hishare/SplitPane.cpp"
TYPECHECK_INCLUDES="source/muscle source/hishare source/hishare/santa source/hishare/santa/BetterScrollView source/hishare/santa/ColumnListView source/hishare/santa/Cursors source/hishare/santa/NewStrings source/hishare/santa/PrefilledBitmap source/hishare/santa/ScrollViewCorner source/muscle/zlib/zlib"
TYPECHECK_CXXFLAGS="-D__HAIKU__ -D_BSD_SOURCE -DMUSCLE_64_BIT_PLATFORM -DMUSCLE_AVOID_IPV6 -DMUSCLE_USE_PTHREADS -DMUSCLE_NO_EXCEPTIONS -DMUSCLE_ENABLE_ZLIB_ENCODING"

# ── Feature test (the app-specific part of release/test-plan.md) ──
# Two LinShare instances on a local muscled (release/test-plan.md): one shares a file, the
# other finds it, downloads it and chats.
FEATURE_CHECKS="query download chat"
EVIDENCE_1="{p}-query.txt|hello-from-{p}\.txt"
EVIDENCE_2="{p}-download.txt|^sha256 match hello-from-{p}\.txt$"
EVIDENCE_3="{p}-chat.txt|chat from {p} B"
